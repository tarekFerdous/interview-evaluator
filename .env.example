ANTHROPIC_API_KEY=sk-ant-...

# Clients must send this in the X-API-Key header. Leave unset to disable auth (local dev only).
SERVICE_API_KEY=

# Postgres + pgvector for stored evaluations, the rubric library and calibration. Leave unset to
# run without persistence. docker compose sets it for the app container automatically.
DATABASE_URL=

# Voyage AI embeddings (rubric suggestions and calibration retrieval). Needed with DATABASE_URL.
VOYAGE_API_KEY=

# Azure AI Speech for recording uploads and the live mic. The key never reaches the browser.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# Optional: the resource's own endpoint (defaults to https://<region>.api.cognitive.microsoft.com)
AZURE_SPEECH_ENDPOINT=

# Per-client-IP limit on evaluation endpoints (requests per minute, burst = the same number).
RATE_LIMIT_PER_MIN=10
